{
  "name": "aura-campaign-view",
  "main": "campaign-view.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.html",
        "**/*-campaign-thumbnails.js"
      ],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
