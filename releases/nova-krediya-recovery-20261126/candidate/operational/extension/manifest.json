{
  "manifest_version": 3,
  "name": "Creditek \u00b7 Krediya para NOVA",
  "version": "1.0.20",
  "minimum_chrome_version": "120",
  "description": "Consulta estados de cuenta de Krediya para expedientes NOVA autorizados, con guardado y cierre confirmados.",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Krediya \u00b7 NOVA",
    "default_popup": "popup.html"
  }
}
