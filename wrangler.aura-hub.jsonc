{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aura-hub",
  "main": "creditek/workers/aura-hub/src/index.js",
  "compatibility_date": "2026-08-01",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "assets": {
    "directory": "./public-aura-hub",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "registro.crediteksas.com/creditek/agentes",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/index.html",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/aura-auth.mjs",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/aura-auth-otp-20260802.mjs",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/creditek-agente-respuestas.html",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/creditek-agente-respuestas",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/sofia-aura-20260803.html",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/sofia-aura-20260803",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/agente3-meta-ads.html",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/agente3-meta-ads",
      "zone_name": "crediteksas.com"
    },
    {
      "pattern": "registro.crediteksas.com/creditek/agentes/agente3-aura-session.mjs",
      "zone_name": "crediteksas.com"
    }
  ]
}
