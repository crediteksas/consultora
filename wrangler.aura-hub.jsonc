{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aura-hub",
  "main": "creditek/workers/aura-hub/src/index.js",
  "compatibility_date": "2026-08-01",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": true }
  ],
  "assets": {
    "directory": "./public-aura-hub-candidate",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "registro.crediteksas.com/creditek/agentes*",
      "zone_name": "crediteksas.com"
    }
  ]
}
