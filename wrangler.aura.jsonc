{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Configuración local no operativa. Sin nombre, rutas, dominios ni bindings productivos.
  "name": "creditek-aura",
  "main": "src/aura-assets-worker.mjs",
  "compatibility_date": "2026-07-23",
  "assets": {
    "directory": "./dist/aura",
    "binding": "ASSETS"
  }
}
