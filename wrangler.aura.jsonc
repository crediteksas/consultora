{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Config operativa de creditek-aura. Sin routes/custom_domains aquí (el dominio se gestiona en Cloudflare directamente).
  "name": "creditek-aura",
  "main": "src/aura-assets-worker.mjs",
  "compatibility_date": "2026-07-23",
  "assets": {
    "directory": "./dist/aura",
    "binding": "ASSETS"
  }
}
